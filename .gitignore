# 非公开数据的物理隔离（D-010）——这些目录永远不进版本控制
data/raw/
data/private/
data/cache/
*.internal.*
*_internal.*

# 下载的年报与中间产物
*.pdf
data/parsed/
data/results/
reports/

# 凭据
.env
.env.*
!.env.example
*.key
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/

