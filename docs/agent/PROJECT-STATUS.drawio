        <mxCell id="d2021" value="D-020  scope_change 改挂 notes.consolidation_scope_change&#10;D-021  NFR-02 加静态托管豁免；NFR-04 改写" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
